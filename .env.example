# Скопируйте в .env на сервере (.env в git не попадает) и заполните
DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com

IMAGE=ghcr.io/your-name/myapp
TAG=latest

POSTGRES_USER=app
POSTGRES_PASSWORD=             # openssl rand -hex 24
POSTGRES_DB=app

SECRET_KEY=                    # openssl rand -hex 32 (в production короче 32 символов приложение не стартует)
LOG_LEVEL=INFO
